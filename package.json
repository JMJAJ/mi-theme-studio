{
  "name": "mi-theme-studio",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "author": "JMJAJ",
  "description": "A desktop studio for creating, inspecting, previewing and packaging MIUI/HyperOS theme packages.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/fetch-scrcpy.mjs && tauri dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "fetch:scrcpy": "node scripts/fetch-scrcpy.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "build:win": "node scripts/bump-version.mjs && node scripts/build-windows.mjs",
    "build:win:ci": "node scripts/build-windows.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
