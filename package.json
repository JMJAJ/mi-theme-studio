{
  "name": "mi-theme-studio",
  "version": "0.1.0",
  "private": true,
  "author": "JMJAJ",
  "description": "A modern desktop workspace for browsing and editing MIUI theme packages.",
  "license": "MIT",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "build": {
    "appId": "dev.mitheme.studio",
    "productName": "Mi Theme Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "assets/**/*",
      "src/**/*",
      "node_modules/fflate/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
