{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mi Theme Studio",
  "version": "../package.json",
  "identifier": "dev.mitheme.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mi Theme Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#121316",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: themeres: http://themeres.localhost https://themeres.localhost https://*.mi-img.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data: themeres: http://themeres.localhost; media-src 'self' themeres: http://themeres.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JMJAJ",
    "shortDescription": "MIUI/HyperOS theme package studio",
    "longDescription": "A local desktop studio for creating, inspecting, previewing and packaging MIUI/HyperOS .mtz theme packages.",
    "category": "DeveloperTool",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
